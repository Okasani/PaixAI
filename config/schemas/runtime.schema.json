{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "default_provider": {
      "default": "local",
      "enum": [
        "local",
        "mock",
        "openai",
        "anthropic",
        "openrouter"
      ],
      "title": "Default Provider",
      "type": "string"
    },
    "local_model": {
      "default": "paix-local",
      "title": "Local Model",
      "type": "string"
    },
    "local_base_url": {
      "default": "http://127.0.0.1:1234/v1",
      "title": "Local Base Url",
      "type": "string"
    },
    "tts_provider": {
      "default": "style_bert_vits2",
      "enum": [
        "style_bert_vits2",
        "elevenlabs",
        "mock"
      ],
      "title": "Tts Provider",
      "type": "string"
    },
    "stage_port": {
      "default": 8765,
      "maximum": 65535,
      "minimum": 1024,
      "title": "Stage Port",
      "type": "integer"
    },
    "trace_enabled": {
      "default": false,
      "title": "Trace Enabled",
      "type": "boolean"
    },
    "rag_enabled": {
      "default": true,
      "title": "Rag Enabled",
      "type": "boolean"
    },
    "rag_limit": {
      "default": 4,
      "maximum": 10,
      "minimum": 1,
      "title": "Rag Limit",
      "type": "integer"
