# Copy to .env. Values below are placeholders or safe local defaults only.
# v0.2 uses a loopback-only local LLM by default. Cloud keys are optional adapter settings
# and are never used unless a cloud provider is explicitly selected.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Optional safer alternative for ElevenLabs. The Windows setup in this project
# can use a git-ignored file instead of placing the secret text in .env.
ELEVENLABS_API_KEY_FILE=.secrets/elevenlabs.key

OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Paix Local Companion
PAIX_HOST=127.0.0.1
PAIX_PORT=8000
PAIX_STAGE_HOST=127.0.0.1
PAIX_STAGE_PORT=8765
PAIX_ALLOWED_WEBSOCKET_ORIGINS=
PAIX_DATABASE_URL=sqlite+aiosqlite:///../data/paix.db
PAIX_LOG_LEVEL=INFO
PAIX_DEFAULT_PROVIDER=local
PAIX_LOCAL_MODEL=paix-local
PAIX_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
PAIX_MOCK_MODEL=paix-mock-1
PAIX_OPENAI_MODEL=gpt-5-mini
PAIX_ANTHROPIC_MODEL=claude-sonnet-4-5
PAIX_OPENROUTER_MODEL=openai/gpt-5-mini
PAIX_MAX_REQUEST_BYTES=1048576
PAIX_MAX_AUDIO_BYTES=16777216
PAIX_STT_MODEL=small.en
PAIX_STT_DEVICE=auto
PAIX_STT_COMPUTE_TYPE=auto
PAIX_VAD_THRESHOLD=0.50
PAIX_VAD_SILENCE_MS=900
PAIX_MAX_UTTERANCE_SECONDS=30
PAIX_ELEVENLABS_VOICE_ID=
PAIX_ELEVENLABS_MODEL=eleven_flash_v2_5
PAIX_TTS_OUTPUT_FORMAT=pcm_24000
RUN_LIVE_API_TESTS=0
